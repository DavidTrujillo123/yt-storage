# --- storage -----------------------------------------------------------------
DATABASE_PATH="./data/yt-storage.db"
DATA_DIR="./data"
# Leave on for SQLite that one person owns; switch to migrations before this
# ever holds someone else's data.
DB_SYNC="true"

# --- secrets -----------------------------------------------------------------
# 32 bytes, base64. Optional: left empty, one is generated on first boot and
# written to $DATA_DIR/secret.key, so a bare `docker compose up` works. Set it
# here to keep the key outside the data directory:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts every YouTube credential: client secrets, refresh tokens, cookie
# jars. Lose it and every connected account has to be set up again; leak it and
# whoever has it owns those Google accounts.
SECRET_KEY=""

# --- the administrator -------------------------------------------------------
# Created on boot when that email has no account yet, so a fresh instance is
# usable immediately. An existing account is never touched: its password
# survives every restart.
#
# The default password is public - it is in this file and in the README - so an
# instance still using it can be signed into by anyone who can reach it, and
# this app holds cookie jars that authenticate every Google service. Change it
# at /setup, or set ADMIN_PASSWORD here before the first boot.
SEED_ADMIN="true"
ADMIN_EMAIL="admin@yt-storage.com"
ADMIN_PASSWORD="Abcd1234"

# --- accounts ----------------------------------------------------------------
# Google client id/secret are NOT set here - each user adds their own Google
# Cloud project per YouTube account at POST /accounts. Only the shared callback
# URL lives in the environment.
#
# This must be the address you actually TYPE IN THE BROWSER, plus
# /accounts/callback - not localhost, if you reach this machine by IP or by a
# Tailscale name - and the identical string has to be registered under
# "Authorized redirect URIs" in every one of those Cloud projects.
#
# Getting it wrong fails late and confusingly: everything works until the
# consent screen, which then refuses with redirect_uri_mismatch. /setup checks
# this for you and says so in red.
#
#   over the LAN     http://192.168.1.50:3000/accounts/callback
#   over Tailscale   http://nas.tail1234.ts.net:8080/accounts/callback
#   behind TLS       https://yts.example.com/accounts/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/accounts/callback"

# Open while the instance has no users, then closed unless this is "true".
ALLOW_REGISTRATION="false"

# --- infra -------------------------------------------------------------------
REDIS_HOST="127.0.0.1"
REDIS_PORT="6380"

# Running natively, this is the port the process listens on. Under Docker it is
# only the HOST side of the mapping - the container always listens on 3000, and
# PORT=8080 publishes 8080:3000. Either way it is the port that belongs in
# GOOGLE_REDIRECT_URI above, because it is the one the browser uses.
PORT="3000"

# Largest single upload accepted, in bytes. Default 5 GiB.
MAX_UPLOAD_BYTES="5368709120"

# Disk budget for restored files, in bytes. Pulling a file back off YouTube
# costs a full video download and decode, so the bytes are kept and re-served;
# the oldest are evicted once the directory passes this. Disposable by design —
# deleting data/cache costs nothing but the next restore.
CACHE_MAX_BYTES="2147483648"

# Path to the codec CLI, run as a child process.
CODEC_CLI="../packages/codec/src/cli.ts"

# The UI's static export, served by this process. Build it with `pnpm build`.
WEB_DIR="../web/out"
