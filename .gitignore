node_modules/
.DS_Store
.env

# What a natively-run instance keeps: the database with every sealed credential
# in it, the incoming uploads, the restore cache. A container keeps this in a
# volume, which is why it went unnoticed here.
data/

# The auto-generated encryption key. Normally it lives under DATA_DIR, which is
# ignored above - but DATA_DIR is configurable, so match it by name too.
secret.key

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
